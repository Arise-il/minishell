#include "./includes/parser.h"
#include <stdlib.h>
#include <string.h>
#include <stdio.h> // for debug only

// Helper functions
int is_operator(char c);
int is_quote(char c);
char *extract_word(...);      // handles quoted strings too
char *extract_operator(...);  // handles >, >>, <, <<

t_token *create_token(char *value, t_token_type type);
void    add_token_back(t_token **head, t_token *new_token);
t_token_type get_token_type(char *value); // new for Day 4

// Main tokenizer function
t_token *tokenize_input(char *line)
{
    t_token *tokens = NULL;
    size_t i = 0;

    while (line[i])
    {
        // Skip whitespace
        if (line[i] == ' ')
        {
            i++;
            continue;
        }

        // Handle quoted strings (single or double)
        if (is_quote(line[i]))
        {
            char *word = extract_word(line, &i); // handles quotes inside
            add_token_back(&tokens, create_token(word, WORD));
        }
        // Handle operators: |, <, >, <<, >>
        else if (is_operator(line[i]))
        {
            char *op = extract_operator(line, &i);
            t_token_type type = get_token_type(op);
            add_token_back(&tokens, create_token(op, type));
        }
        // Normal word
        else
        {
            char *word = extract_word(line, &i);
            add_token_back(&tokens, create_token(word, WORD));
        }
    }

    return tokens;
}
